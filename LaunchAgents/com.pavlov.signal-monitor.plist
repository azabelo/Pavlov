<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pavlov.signal-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/andrewzabelo/Desktop/Pavlov/.build/PavlovD-Rust.app/Contents/MacOS/pavlovd-rs</string>
    <string>monitor</string>
    <string>--intensity</string>
