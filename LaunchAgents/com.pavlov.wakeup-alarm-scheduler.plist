<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pavlov.wakeup-alarm-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/andrewzabelo/.pavlov/schedule_wakeup_alarms.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/pavlov-wakeup-alarm-scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pavlov-wakeup-alarm-scheduler.stderr.log</string>
</dict>
</plist>
